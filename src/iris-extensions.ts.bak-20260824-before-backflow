      const fm = raw.match(/^---\n([\s\S]*?)\n---/);
      if (fm) {
        const pick = (k: string) => fm[1].match(new RegExp(`^${k}:\\s*(.+)$`, "m"))?.[1]?.trim() ?? "?";
        fvBlock = `\n• 現有 thesis：px **${pick("current_price")}** / fv **${pick("fair_value")}** / rating **${pick("rating")}** · ${pick("last_updated")}`;
      }
    } catch { /* ignore */ }
