  const exists = fs.existsSync(thesisPath);
  const archiveDir = path.join(THESIS_DIR, upper, "archive");
  let lastAudit = "(無歷史)";
  if (fs.existsSync(archiveDir)) {
    try {
      const files = fs.readdirSync(archiveDir).filter(f => f.endsWith(".md")).sort();
      if (files.length > 0) lastAudit = files[files.length - 1];
    } catch { /* ignore */ }
  }
  let fvBlock = "";
  if (exists) {
    try {
