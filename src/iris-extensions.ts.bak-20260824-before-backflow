/**
 * IrisBot extensions — v0.1.
 *
 * Implements 8 /iris-* slash commands per
 *   ~/.agents/iris/iris_slash_commands_spec.md
 *
 * Light (direct read/spawn, <30s):
 *   /iris-handoff   — pull latest TODAY_SUMMARY
 *   /iris-holdings  — 7-ticker snapshot from thesis frontmatter
 *   /iris-status    — concurrency state
 *   /iris-recall    — gbrain ask
 *   /iris-sector    — stub (wraps us_sector_rotation script, v0.2)
 *   /iris-aaii      — stub (wraps aaii fetcher, v0.2)
 *
 * Light-medium:
 *   /iris-kaigong   — handoff + gbrain warm-up composite
 *
 * Heavy:
 *   /iris-audit <T> — stub for v0.1 (spawns mega-reality-auditor in v0.2)
 */
import fs from "fs";
import path from "path";
import os from "os";
import { spawn } from "child_process";

const HOME = os.homedir();
// Canonical vault is D:\ai-memory (not ~/ai-memory — that path is only a junction).
const AI_MEMORY = process.env.AI_MEMORY_ROOT ?? "D:\\ai-memory";
const HANDOFF_DIR = path.join(AI_MEMORY, "core");
const THESIS_DIR = path.join(AI_MEMORY, "research", "companies");

const HOLDINGS = ["BWXT", "CCJ", "CEG", "VST", "ASTS", "PLTR", "NET"];
const TICKER_RE = /^[A-Z0-9.]{1,8}$/;

// ─── /iris-handoff ───────────────────────────────────────────────────────

export function renderHandoff(): string {
  try {
    const files = fs.readdirSync(HANDOFF_DIR)
      .filter(f => /^TODAY_SUMMARY_\d+\.md$/.test(f))
      .sort();
    if (files.length === 0) {
      return `📭 **找不到 handoff 檔**\n\n\`${HANDOFF_DIR}\` 下沒有 TODAY_SUMMARY_*.md，可能 session-handoff 還沒跑。`;
    }
    const latest = files[files.length - 1];
    const text = fs.readFileSync(path.join(HANDOFF_DIR, latest), "utf-8");
    const preview = text.length > 1700 ? text.slice(0, 1700) + "\n\n*…(truncated)*" : text;
    return `📄 **最新 handoff — ${latest}**\n\n${preview}`;
  } catch (err) {
    return `⚠️ 讀 handoff 失敗：${(err as Error).message}`;
  }
}

// ─── /iris-holdings ──────────────────────────────────────────────────────

export function renderHoldings(): string {
  const rows: string[] = [];
  for (const t of HOLDINGS) {
    const p = path.join(THESIS_DIR, t, "thesis.md");
    if (!fs.existsSync(p)) { rows.push(`• **${t}** — *(thesis missing)*`); continue; }
    try {
      const raw = fs.readFileSync(p, "utf-8");
      const fm = raw.match(/^---\n([\s\S]*?)\n---/);
      if (!fm) { rows.push(`• **${t}** — *(no frontmatter)*`); continue; }
      const pick = (k: string) => fm[1].match(new RegExp(`^${k}:\\s*(.+)$`, "m"))?.[1]?.trim() ?? "?";
      const fv = pick("fair_value");
      const cp = pick("current_price");
      const rating = pick("rating");
      const lu = pick("last_updated");
      rows.push(`• **${t}** — px **${cp}** / fv **${fv}** / rating **${rating}** · ${lu}`);
    } catch {
      rows.push(`• **${t}** — *(read error)*`);
    }
  }
  const stamp = new Date().toLocaleString("zh-TW", { timeZone: "Asia/Taipei" });
  return `📦 **Iris 持倉快照**（${stamp}）\n\n${rows.join("\n")}\n\n*source: \`ai-memory/research/companies/{T}/thesis.md\` frontmatter*`;
}

// ─── /iris-recall ────────────────────────────────────────────────────────

export async function runRecall(query: string, timeoutMs = 45_000): Promise<string> {
  return new Promise((resolve) => {
    const child = spawn("gbrain", ["ask", query], { shell: true });
    let stdout = ""; let stderr = "";
    child.stdout.on("data", d => { stdout += d.toString(); });
    child.stderr.on("data", d => { stderr += d.toString(); });
    const timer = setTimeout(() => { child.kill(); resolve(`⏱️ Gbrain 超時（${timeoutMs / 1000}s）`); }, timeoutMs);
    child.on("close", (code) => {
      clearTimeout(timer);
      if (code === 0 && stdout.trim()) {
        const out = stdout.trim().slice(0, 1700);
        resolve(`🧠 **Gbrain: ${query}**\n\n${out}`);
      } else {
        const err = (stderr || stdout || "(no output)").trim().slice(0, 1500);
        resolve(`⚠️ Gbrain 查詢失敗（exit ${code}）\n\`\`\`\n${err}\n\`\`\``);
      }
    });
    child.on("error", (err) => {
      clearTimeout(timer);
      resolve(`⚠️ Gbrain 啟動失敗：${err.message}（確認 gbrain CLI 在 PATH）`);
    });
  });
}

// ─── /iris-kaigong ───────────────────────────────────────────────────────

export async function runKaigong(): Promise<string> {
  // 1. Latest handoff preview
  let handoffSection = "";
  try {
    const files = fs.readdirSync(HANDOFF_DIR)
      .filter(f => /^TODAY_SUMMARY_\d+\.md$/.test(f))
      .sort();
    if (files.length > 0) {
      const latest = files[files.length - 1];
      const text = fs.readFileSync(path.join(HANDOFF_DIR, latest), "utf-8");
      const m = text.match(/^###?\s*待續工作[\s\S]*?(?=^##|^###\s|\Z)/m);
      const snippet = m ? m[0].trim() : text.slice(0, 600);
      handoffSection = `## 📄 今日狀態（source: ${latest}）\n\n${snippet.slice(0, 900)}`;
    } else {
      handoffSection = `## 📄 今日狀態\n\n*(無 TODAY_SUMMARY — 跑 /session-handoff 先)*`;
    }
  } catch (err) {
    handoffSection = `## 📄 今日狀態\n\n⚠️ ${(err as Error).message}`;
  }

  // 2. Gbrain warm-up (持倉風險 + 宏觀 + 急迫 action)
  let gbrainSection = "";
  try {
    const q = "今日持倉最大風險 + 最新宏觀象限 + 急迫 action";
    const result = await runRecall(q, 30_000);
    // Strip the leading "🧠 **Gbrain: ...**\n\n" if present
    const clean = result.replace(/^🧠\s*\*\*Gbrain:.*?\*\*\s*\n+/, "");
    gbrainSection = `## 🧠 Gbrain 語義補充\n\n${clean.slice(0, 700)}`;
  } catch (err) {
    gbrainSection = `## 🧠 Gbrain 語義補充\n\n⚠️ ${(err as Error).message}`;
  }

  const stamp = new Date().toLocaleString("zh-TW", { timeZone: "Asia/Taipei" });
  return `🚀 **開工（${stamp}）**\n\n${handoffSection}\n\n${gbrainSection}\n\n---\n*下一步想從哪開始？*`;
}

// ─── /iris-audit (stub v0.1) ─────────────────────────────────────────────

export function validateTicker(raw: string): string | null {
  const upper = raw.trim().toUpperCase();
  return TICKER_RE.test(upper) ? upper : null;
}

