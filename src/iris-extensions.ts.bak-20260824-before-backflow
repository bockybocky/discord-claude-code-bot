// ─── /iris-sector ────────────────────────────────────────────────────────

const SECTOR_SCRIPT = path.join(HOME, "scripts", "sector_rotation.py");

export async function runSectorSummary(timeoutMs = 60_000): Promise<string> {
  if (!fs.existsSync(SECTOR_SCRIPT)) {
    return `⚠️ 找不到 \`${SECTOR_SCRIPT}\`，無法執行 sector rotation。`;
  }
  return new Promise((resolve) => {
    const child = spawn("python", [SECTOR_SCRIPT, "--summary"], { shell: true });
    let stdout = ""; let stderr = "";
    child.stdout.on("data", d => { stdout += d.toString(); });
    child.stderr.on("data", d => { stderr += d.toString(); });
    const timer = setTimeout(() => { child.kill(); resolve(`⏱️ sector_rotation 超時（${timeoutMs / 1000}s）`); }, timeoutMs);
    child.on("close", (code) => {
      clearTimeout(timer);
      if (code === 0 && stdout.trim()) {
        const out = stdout.trim();
        const header = `📊 **美股板塊輪動（11 GICS，L1）**\n*source: scripts/sector_rotation.py --summary*\n\n`;
        const body = out.length > 1700 ? out.slice(0, 1700) + "\n\n*…(truncated, 跑 L2/L3 用 /iris-sector --full 待 v0.3)*" : out;
        resolve(header + body);
      } else {
        const err = (stderr || stdout || "(no output)").trim().slice(0, 1500);
        resolve(`⚠️ sector_rotation 失敗（exit ${code}）\n\`\`\`\n${err}\n\`\`\``);
      }
    });
    child.on("error", (err) => {
      clearTimeout(timer);
      resolve(`⚠️ 啟動失敗：${err.message}`);
    });
  });
}

// ─── /iris-aaii ──────────────────────────────────────────────────────────

const AAII_JSON = path.join(AI_MEMORY, "data", "aaii_history.json");

interface AaiiRow {
  date: string;
  bullish: number | null;
  neutral: number | null;
  bearish: number | null;
}

export function renderAaii(): string {
  if (!fs.existsSync(AAII_JSON)) {
    return `⚠️ 找不到 \`${AAII_JSON}\`，AAII 歷史檔未就位。`;
  }
  let rows: AaiiRow[];
  try {
    rows = JSON.parse(fs.readFileSync(AAII_JSON, "utf-8")) as AaiiRow[];
  } catch (err) {
    return `⚠️ AAII JSON 解析失敗：${(err as Error).message}`;
  }
  const complete = rows.filter(r => r.bullish != null && r.neutral != null && r.bearish != null);
  if (complete.length === 0) return `⚠️ AAII 歷史檔無完整資料列`;
  const latest = complete[complete.length - 1];
  const spread = (latest.bullish! - latest.bearish!).toFixed(1);
  const lastN = complete.slice(-9, -1); // last 8 weeks before current
  const avgBull = lastN.length > 0 ? lastN.reduce((s, r) => s + r.bullish!, 0) / lastN.length : latest.bullish!;
  const avgBear = lastN.length > 0 ? lastN.reduce((s, r) => s + r.bearish!, 0) / lastN.length : latest.bearish!;
  const bullDelta = (latest.bullish! - avgBull).toFixed(1);
  const bearDelta = (latest.bearish! - avgBear).toFixed(1);

  let regime = "🟡 中性";
  if (latest.bullish! >= 40) regime = "🟢 偏多過熱";
  else if (latest.bullish! <= 20) regime = "🔴 極悲觀";
  else if (latest.bearish! >= 45) regime = "🔴 恐慌偏高";
  else if (latest.bearish! <= 20) regime = "🟢 樂觀";

  const extreme = Number(spread) <= -15 ? " ⚠️ **Bull-Bear <-15 極悲觀**" :
                  Number(spread) >= 25 ? " ⚠️ **Bull-Bear >25 過熱**" : "";

  return [
    `📈 **AAII 散戶情緒（${latest.date}）**`,
    ``,
    `| 指標 | 本週 | 8W avg | Δ |`,
    `|------|------|--------|---|`,
    `| Bullish | **${latest.bullish}%** | ${avgBull.toFixed(1)}% | ${Number(bullDelta) >= 0 ? "+" : ""}${bullDelta} |`,
    `| Neutral | ${latest.neutral}% | — | — |`,
    `| Bearish | **${latest.bearish}%** | ${avgBear.toFixed(1)}% | ${Number(bearDelta) >= 0 ? "+" : ""}${bearDelta} |`,
    `| Spread (Bull-Bear) | **${spread}** | — | — |`,
    ``,
    `**情緒 regime**：${regime}${extreme}`,
    ``,
    `*source: D:/ai-memory/data/aaii_history.json（${complete.length} 筆完整歷史）*`,
    `*資料更新節奏：每週四 AAII 官方發布*`,
  ].join("\n");
}
