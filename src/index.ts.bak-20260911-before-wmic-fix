function isArxivUrl(url: string): boolean {
  try {
    const u = new URL(url);
    const host = u.hostname.replace(/^www\./, "").toLowerCase();
    return (host === "arxiv.org" || host === "export.arxiv.org") && /\/(abs|pdf|html)\//i.test(u.pathname);
  } catch {
    return false;
  }
}

