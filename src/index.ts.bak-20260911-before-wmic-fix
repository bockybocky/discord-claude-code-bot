  const lines = raw.replace(/```[\s\S]*?```/g, "").split(/\r?\n/).map(stripSummaryLinePrefix).filter(Boolean);
  const first = (lines[0] || "這份材料未產生摘要").slice(0, 180);
  const second = hits.length
    ? `${hits.join("、")}：${(lines[1] || "模型未補充命中原因").slice(0, 180)}`
